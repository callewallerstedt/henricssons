</head>
<body class="hb-premium">
    <div class="hb-top"><div class="wrap"><div class="hb-top-left"><span>Familjeföretag sedan 1967 · Kungsbacka</span></div><div class="hb-top-right"><a href="tel:+46314718200">+46 (0)31 47 18 20</a><a href="mailto:info@henricssonsbatkapell.se">info@henricssonsbatkapell.se</a></div></div></div>
    <header class="hb-header"><div class="wrap hb-nav"><a href="/" class="hb-logo"><img src="logo.png" alt="Henricssons Båtkapell"/></a><button class="hb-burger" aria-label="Meny" onclick="document.getElementById('hbNav').classList.toggle('is-open')"><span></span><span></span><span></span></button><nav class="hb-nav-links" id="hbNav"><a href="/om-oss">Om oss</a><a href="/bilder-och-exempel">Bilder &amp; exempel</a><a href="/tillbehor">Fenderstrumpor</a><a href="/kontakt">Kontakt</a><a href="/kapellforfragan" class="hb-nav-cta active">Begär offert</a></nav></div></header>

    <section class="hb-pagehero">
        <div class="hb-pagehero-bg"><img src="bakgrundhav.webp" alt=""/></div>
        <div class="wrap"><span class="eyebrow">Kapellförfrågan</span><span class="rule"></span><h1>Skicka en <em>kapellförfrågan</em></h1><p class="lead">Välj tillverkare och modell om du hittar den. Annars skriver du in båtens uppgifter direkt i formuläret.</p></div>
    </section>

    <section class="hb-section">
        <div class="wrap hb-contact-grid">
            <div>
                <div class="hb-selector-card">
                    <h2>Välj båttillverkare</h2>
                    <p>Sök i rutan och välj en tillverkare.</p>
                    <div class="hb-form-row"><input class="quicksearch" type="text" placeholder="Sök tillverkare..." id="tillverkare"></div>
                    <div id="clear-qs" class="clear-qs"></div>
                    <div id="tillverkare-container" class="tillverkare-wrapper"><div class="grid1-wrapper"><div class="grid1"></div></div></div>
                    <a id="rensa-grid1" data-filter="-" href="#" class="rensa-button">Rensa val</a>
                </div>
                <div id="modell-container" class="hb-selector-card inaktiv">
                    <h2>Välj båtmodell</h2>
                    <div id="modeller" class="modeller-wrapper"><div class="grid2-wrapper"><div class="grid2"></div></div></div>
                    <a id="rensa-grid2" data-filter="-" href="#" class="rensa-button">Rensa modell</a>
                </div>
                <div class="hb-selector-card">
                    <h2>Så fungerar det</h2>
                    <p>Vi har ett stort mallregister och kan även malla båten i hamn eller hos oss. Bifoga gärna bilder på båten, gamla kapellet eller detaljer som är viktiga.</p>
                </div>
            </div>

            <form id="contact-form" class="hb-form-card contact-form" data-subject="Kapellförfrågan">
                <h2>Kontaktuppgifter</h2>
                <p class="subtitle">Vi återkommer med pris och leveranstid så snart vi kan.</p>
                <div class="hb-form-grid-2"><div class="hb-form-row"><label for="name">Namn *</label><input id="name" name="1. Namn" required></div><div class="hb-form-row"><label for="phone">Telefon *</label><input id="phone" name="2. Telefonnummer" type="tel" required></div></div>
                <div class="hb-form-row"><label for="email">E-post *</label><input id="email" name="3. E-postadress" type="email" required></div>
                <div class="hb-form-grid-2"><div class="hb-form-row"><label for="T-field">Tillverkare</label><input id="T-field" name="4. Tillverkare"></div><div class="hb-form-row"><label for="M-field">Modell</label><input id="M-field" name="5. Modell"></div></div>
                <div class="hb-form-grid-2"><div class="hb-form-row"><label for="boatYear">Årsmodell</label><input id="boatYear" name="6. Årsmodell"></div><div class="hb-form-row"><label for="homePort">Hemmahamn</label><input id="homePort" name="7. Hemmahamn"></div></div>
                <div class="hb-form-row"><label for="oldCanopy">Tillverkare av befintligt kapell</label><input id="oldCanopy" name="8. Tillverkare av befintligt kapell"></div>
                <div class="hb-form-row"><label for="message">Övrig information</label><textarea id="message" name="9. Övrig information"></textarea></div>
                <div id="kapellAttachments"></div>
                <button type="submit" class="hb-btn hb-btn-primary"><span>Skicka förfrågan</span></button>
                <div class="hb-form-done">Förfrågan skickad! Vi återkommer så snart vi kan.</div>
            </form>
        </div>
    </section>

    <footer class="hb-footer"><div class="wrap"><div class="grid"><div class="brand"><img src="logo.png" alt="Henricssons Båtkapell"/><p>Familjeföretag i Kungsbacka sedan 1967.</p></div><div><h5>Navigera</h5><ul><li><a href="/om-oss">Om oss</a></li><li><a href="/bilder-och-exempel">Bilder &amp; exempel</a></li><li><a href="/kontakt">Kontakt</a></li></ul></div><div><h5>Kontakt</h5><ul><li><a href="tel:+46314718200">+46 (0)31 47 18 20</a></li><li><a href="mailto:info@henricssonsbatkapell.se">info@henricssonsbatkapell.se</a></li></ul></div></div></div></footer>

    <script src="https://unpkg.com/isotope-layout@3/dist/isotope.pkgd.min.js"></script>
    <script src="kapellforfragan.js?v=20260419"></script>
    <script src="form_attachments.js?v=20260419"></script>
    <script>
        const kapellAttachmentWidget = window.HenricssonsAttachments ? window.HenricssonsAttachments.create('#kapellAttachments', { label: 'Bifoga bilder på båten/kapellet (valfritt)', helper: 'Ladda upp här' }) : { getFiles: () => [], reset: () => {} };
        document.querySelector('.contact-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const form = e.currentTarget;
            const btn = form.querySelector('button[type="submit"]');
            const original = btn.textContent;
            btn.disabled = true; btn.textContent = 'Skickar...';
            const fields = {};
            new FormData(form).forEach((value, key) => { fields[key.replace(/^\d+\.\s*/, '')] = value; });
            const api = location.hostname === 'localhost' || location.hostname === '127.0.0.1' ? `${location.protocol}//${location.hostname}:25565` : 'https://henricssons-api.onrender.com';
            const payload = JSON.stringify({ form_type: form.dataset.subject || 'Kapellförfrågan', fields });
            try {
                const files = kapellAttachmentWidget.getFiles();
                let resp;
                if (files.length) {
                    const fd = new FormData();
                    fd.append('payload', payload);
                    files.forEach(f => fd.append('attachments', f, f.name));
                    resp = await fetch(`${api}/api/submit_form`, { method: 'POST', body: fd });
                } else {
                    resp = await fetch(`${api}/api/submit_form`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload });
                }
                if (!resp.ok) throw new Error('submit failed');
                btn.remove();
                form.querySelector('.hb-form-done').style.display = 'block';
                kapellAttachmentWidget.reset();
            } catch (_) {
                btn.disabled = false; btn.textContent = original;
                alert('Kunde inte skicka formuläret. Försök igen.');
            }
        });
    </script>
    <script src="chat_widget.js?v=20260416d"></script>
</body>
</html>
